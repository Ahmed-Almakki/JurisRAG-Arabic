DB_HOST=localhost
DB_PORT=5432
DB_NAME=jurisage_db
DB_USER=postgres
DB_PASSWORD=postgres

GROQ_API_KEY_EVAL=your-groq-api-key #This for evaluation
GROQ_API_KEY_RAG=your-groq-api-key # This is also groq but for the RAG system

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=jurisrag_arabic_v3
MLFLOW_BACKEND_STORE_URI=postgresql://${DB_USER}:${DB_PASSWORD}@jurisage-db:${DB_PORT}/${DB_NAME}

PDF_FILENAME=legal_doc.pdf
PDF_OUTPUT_FILENAME=legal_doc.json

# Optional: use your host user IDs for writable bind-mounted output files.
LOCAL_UID=1000
LOCAL_GID=1000
RAG_PORT=3000
